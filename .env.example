# --- BACKEND ---
# Security: Never commit the actual .env file
# Database Configuration (Can be loaded from Google Secret Manager in production)
DATABASE_URL=sqlite+aiosqlite:///./test.db  # Use SQLite for local dev, Postgres for production

# Google Cloud Configuration
GOOGLE_CLOUD_PROJECT=promptwars-team-collab-tool
# GOOGLE_APPLICATION_CREDENTIALS=path/to/credentials.json

# JWT Authentication (Fallback if Firebase is bypassed in dev)
SECRET_KEY=your-super-secret-key-do-not-share
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS settings
ALLOWED_ORIGINS=http://localhost:5173

# --- FRONTEND ---
VITE_API_URL=http://localhost:8000
# VITE_FIREBASE_API_KEY=your-api-key
# VITE_FIREBASE_AUTH_DOMAIN=your-auth-domain
# VITE_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
